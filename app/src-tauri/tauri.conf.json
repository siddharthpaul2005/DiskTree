{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiskTree",
  "version": "1.1.0",
  "identifier": "com.disktree.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "DiskTree",
        "width": 1280,
        "height": 760,
        "minWidth": 980,
        "minHeight": 600,
        "center": true,
        "transparent": true,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* https://api.github.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "DiskTree",
    "category": "Utility",
    "shortDescription": "Storage intelligence for Windows",
    "longDescription": "DiskTree scans your drives in seconds and shows where your space goes, what changed, and what to clean.",
    "externalBin": ["binaries/disktree-engine"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
